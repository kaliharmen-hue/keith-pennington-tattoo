---
import '../styles/global.css';

const {
  title = 'Keith Pennington Tattoo Artist',
  description = 'Custom tattoo work by Keith Pennington in Shirley, Southampton.',
  current = ''
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const navItems = [
  { href: base, label: 'Home', key: 'home' },
  { href: `${base}about/`, label: 'About', key: 'about' },
  { href: `${base}gallery/`, label: 'Gallery', key: 'gallery' },
  { href: `${base}contact/`, label: 'Contact', key: 'contact' }
];
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base} aria-label="Keith Pennington Tattoo home">
        <span class="brand-mark">KP</span>
        <span>
          <strong>Keith Pennington</strong>
          <small>Tattoo Artist</small>
        </span>
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        {navItems.map((item) => (
          <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
      <a class="header-cta" href={`${base}contact/`}>Start enquiry</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <strong>Keith Pennington Tattoo</strong>
        <p>Custom tattoo work in Shirley, Southampton.</p>
      </div>
      <nav aria-label="Footer navigation">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </footer>
  </body>
</html>
