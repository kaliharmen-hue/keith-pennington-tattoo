---
import '../styles/global.css';

const {
  title = 'Inked Skin | Keith Pennington Tattoo Artist',
  description = 'Custom tattoo work at Inked Skin by Keith Pennington in Shirley, Southampton.',
  current = ''
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const logoSrc = `${base}assets/logo/inkedskin-logo-inverse-transparent-silver-detail.png`;
const faviconSrc = `${base}assets/logo/inked-skin-favicon-512.png`;
const shareImageSrc = `${base}assets/logo/inked-skin-southampton-share.jpg`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const shareImageUrl = new URL(shareImageSrc, Astro.site).toString();
const navItems = [
  { href: base, label: 'Home', key: 'home' },
  { href: `${base}about/`, label: 'About', key: 'about' },
  { href: `${base}gallery/`, label: 'Gallery', key: 'gallery' },
  { href: `${base}contact/#how-it-works`, label: 'How It Works', key: 'how-it-works' },
  { href: `${base}contact/#faqs`, label: 'FAQs', key: 'faqs' },
  { href: `${base}contact/`, label: 'Contact', key: 'contact' }
];
const instagramUrl = 'https://www.instagram.com/inkedskin_uk/';
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="Inked Skin" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content="1356" />
    <meta property="og:image:height" content="849" />
    <meta property="og:image:alt" content="Inked Skin tattoo studio logo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImageUrl} />
    <link rel="icon" type="image/png" sizes="512x512" href={faviconSrc} />
    <link rel="apple-touch-icon" href={faviconSrc} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base} aria-label="Inked Skin home">
        <span class="brand-logo">
          <img src={logoSrc} alt="Inked Skin" />
        </span>
        <span>
          <strong>Inked Skin</strong>
          <small>Keith Pennington, Tattoo Artist</small>
        </span>
      </a>
      <button class="menu-toggle" type="button" aria-controls="main-navigation" aria-expanded="false">
        <span class="menu-toggle-label">Menu</span>
        <span class="menu-toggle-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
      <nav class="site-nav" id="main-navigation" aria-label="Main navigation">
        {navItems.map((item) => (
          <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
      <a class="header-cta" href={`${base}contact/`}>Start enquiry</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <strong>Inked Skin</strong>
        <p>Custom tattoo work by Keith Pennington in Shirley, Southampton.</p>
      </div>
      <nav aria-label="Footer navigation">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href={instagramUrl} target="_blank" rel="noopener noreferrer">Instagram</a>
      </nav>
    </footer>
    <script>
      const menuToggle = document.querySelector('.menu-toggle');
      const siteHeader = document.querySelector('.site-header');

      menuToggle?.addEventListener('click', () => {
        const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';

        menuToggle.setAttribute('aria-expanded', String(!isOpen));
        siteHeader?.classList.toggle('nav-open', !isOpen);
      });
    </script>
  </body>
</html>
