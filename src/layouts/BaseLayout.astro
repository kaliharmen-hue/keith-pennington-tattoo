---
import '../styles/global.css';

const {
  title = 'Inked Skin | Keith Pennington Tattoo Artist',
  description = 'Custom tattoo work at Inked Skin by Keith Pennington in Shirley, Southampton.',
  current = ''
} = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const logoSrc = `${base}assets/logo/inked-skin-logo-new.png`;
const faviconSrc = `${base}assets/logo/inked-skin-favicon-new.png`;
const shareImageSrc = `${base}assets/logo/inked-skin-southampton-share.jpg`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const shareImageUrl = new URL(shareImageSrc, Astro.site).toString();
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.inkedskin.co.uk';
const navItems = [
  { href: base, label: 'Home', key: 'home' },
  { href: `${base}about/`, label: 'About', key: 'about' },
  { href: `${base}gallery/`, label: 'Gallery', key: 'gallery' },
  { href: `${base}contact/#how-it-works`, label: 'How It Works', key: 'how-it-works' },
  { href: `${base}contact/#faqs`, label: 'FAQs', key: 'faqs' },
  { href: `${base}contact/`, label: 'Contact', key: 'contact' }
];
const instagramUrl = 'https://www.instagram.com/inkedskin_uk/';
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'TattooParlor'],
  '@id': `${siteUrl}/#inked-skin`,
  name: 'Inked Skin',
  alternateName: 'Inked Skin Tattoo',
  url: siteUrl,
  image: shareImageUrl,
  logo: new URL(logoSrc, Astro.site).toString(),
  description: 'Custom tattoo work by Keith Pennington at Inked Skin in Shirley, Southampton.',
  founder: {
    '@type': 'Person',
    name: 'Keith Pennington',
    jobTitle: 'Tattoo Artist'
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Shirley',
    addressRegion: 'Southampton',
    addressCountry: 'GB'
  },
  areaServed: [
    { '@type': 'Place', name: 'Shirley' },
    { '@type': 'City', name: 'Southampton' },
    { '@type': 'AdministrativeArea', name: 'Hampshire' }
  ],
  sameAs: [instagramUrl],
  makesOffer: [
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Custom tattoos' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Black and grey tattoos' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Fine line tattoos' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Script tattoos' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Cover-up tattoos' } }
  ]
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:site_name" content="Inked Skin" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content="1356" />
    <meta property="og:image:height" content="849" />
    <meta property="og:image:alt" content="Inked Skin tattoo studio logo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImageUrl} />
    <link rel="icon" type="image/png" href={faviconSrc} />
    <link rel="apple-touch-icon" href={faviconSrc} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base} aria-label="Inked Skin home">
        <span class="brand-logo">
          <img src={logoSrc} alt="Inked Skin" />
        </span>
        <span>
          <strong>Inked Skin</strong>
          <small>Keith Pennington, Tattoo Artist</small>
        </span>
      </a>
      <button class="menu-toggle" type="button" aria-controls="main-navigation" aria-expanded="false">
        <span class="menu-toggle-label">Menu</span>
        <span class="menu-toggle-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
      <nav class="site-nav" id="main-navigation" aria-label="Main navigation">
        {navItems.map((item) => (
          <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
      <a class="header-cta" href={`${base}contact/`}>Start enquiry</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <strong>Inked Skin</strong>
        <p>Custom tattoo work by Keith Pennington in Shirley, Southampton.</p>
      </div>
      <nav aria-label="Footer navigation">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
        <a class="social-link" href={instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg class="social-icon" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5" ry="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r="1.2"></circle>
          </svg>
        </a>
      </nav>
    </footer>
    <script>
      const menuToggle = document.querySelector('.menu-toggle');
      const siteHeader = document.querySelector('.site-header');

      menuToggle?.addEventListener('click', () => {
        const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';

        menuToggle.setAttribute('aria-expanded', String(!isOpen));
        siteHeader?.classList.toggle('nav-open', !isOpen);
      });
    </script>
  </body>
</html>
