---
import BaseLayout from '../layouts/BaseLayout.astro';

const notes = [
  'A deposit will be required to secure your appointment',
  'Deposits are usually non-refundable',
  'Final pricing depends on size, placement, detail and session time',
  'You must be 18 or over to get tattooed',
  'Valid ID may be required',
  'Please do not attend your appointment under the influence of alcohol or drugs'
];
---
<BaseLayout
  current="contact"
  title="Book a Tattoo Consultation | Inked Skin Southampton"
  description="Send your tattoo idea to Keith Pennington at Inked Skin and start your booking enquiry. Custom tattoos, cover-ups, script and fine line work in Shirley, Southampton."
>
  <section class="page-hero contact-hero">
    <p class="eyebrow">Bookings</p>
    <h1>Book a tattoo consultation</h1>
    <p>Ready to start the conversation? Send Keith your tattoo idea. You do not need a perfect brief. A rough idea is enough to begin.</p>
  </section>

  <section class="section contact-layout">
    <form class="booking-form" action="https://formsubmit.co/keith.inkedskin@gmail.com" method="post">
      <input type="hidden" name="_subject" value="New tattoo enquiry from Inked Skin website" />
      <input type="hidden" name="_template" value="table" />
      <input type="text" name="_honey" class="spam-trap" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <div class="form-grid three-up">
        <label>
          <span>Name</span>
          <input type="text" name="name" autocomplete="name" required />
        </label>
        <label>
          <span>Email address</span>
          <input type="email" name="email" autocomplete="email" required />
        </label>
        <label>
          <span>Phone number</span>
          <input type="tel" name="phone" autocomplete="tel" />
        </label>
      </div>
      <label>
        <span>Tattoo idea</span>
        <textarea name="idea" rows="6" minlength="20" required></textarea>
      </label>
      <div class="form-grid two-up">
        <label>
          <span>Placement</span>
          <input type="text" name="placement" />
        </label>
        <label>
          <span>Approximate size</span>
          <input type="text" name="size" />
        </label>
      </div>
      <label>
        <span>Preferred dates or availability</span>
        <input type="text" name="availability" />
      </label>
      <label>
        <span>Anything else Keith should know?</span>
        <textarea name="details" rows="4"></textarea>
      </label>
      <div class="form-actions">
        <button class="button primary" type="submit">Submit your enquiry</button>
        <p class="form-note">Protected with a hidden spam trap and form-service spam checks.</p>
      </div>
    </form>

    <aside class="booking-aside">
      <div>
        <p class="eyebrow">What to include</p>
        <h2>The more detail you can give, the easier it is to advise on design, timing and price.</h2>
        <ul>
          <li>Your tattoo idea</li>
          <li>Approximate size and placement</li>
          <li>Style, such as black and grey, fine line or script</li>
          <li>Reference images</li>
          <li>Whether it is new work, a cover-up or a rework</li>
          <li>Any budget you are working with</li>
        </ul>
      </div>
      <div>
        <p class="eyebrow">Before booking</p>
        <ul>
          {notes.map((note) => <li>{note}</li>)}
        </ul>
      </div>
    </aside>
  </section>
</BaseLayout>
