---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const approachImage = `${base}assets/about/keith-pennington-tattoo-artist.png`;
const galleryPreview = [
  { src: `${base}assets/gallery/gallery-01.jpeg`, label: 'Black and grey tattoo' },
  { src: `${base}assets/gallery/gallery-20.jpeg`, label: 'Custom tattoo detail' },
  { src: `${base}assets/gallery/gallery-27.jpeg`, label: 'Recent tattoo work' }
];
---
<BaseLayout
  current="home"
  title="Inked Skin | Keith Pennington Tattoo Artist in Shirley, Southampton"
  description="Custom tattoo work at Inked Skin by Keith Pennington in Shirley, Southampton. Thoughtful black and grey, fine line, script and personal tattoo designs without the ego."
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Inked Skin, Shirley Southampton</p>
      <h1>Custom tattoos without the ego</h1>
      <p class="lede">Thoughtful tattoo work designed with care, shaped around your ideas and created to last.</p>
      <div class="button-row">
        <a class="button primary" href={`${base}contact/`}>Book a consultation</a>
        <a class="button secondary" href={`${base}gallery/`}>View the gallery</a>
      </div>
    </div>
  </section>

  <section class="section approach-section">
    <div class="section-inner approach-inner">
      <div class="approach-copy">
        <p class="eyebrow">A calmer way to get tattooed</p>
        <h2>Good tattooing starts before the needle comes out.</h2>
        <p>Getting a tattoo is personal. At Inked Skin, Keith takes the time to understand what you want, how it will sit on the body and how it will age over time.</p>
        <h3>Clear guidance, steady work and designs that fit the body.</h3>
        <p>Every tattoo starts with a conversation. If your idea needs refining, resizing or adjusting to work better as a tattoo, Keith will guide you through it clearly.</p>
        <p class="specialisms">Keith specialises in black and grey, fine line, script, symbolic tattoos, cover-ups, reworks and small personal pieces.</p>
      </div>
      <div class="approach-side">
        <figure class="approach-image">
          <img src={approachImage} alt="Keith Pennington tattooing at Inked Skin" loading="lazy" />
        </figure>
      </div>
      <div class="promise-strip" aria-label="Keith's approach">
        <span>No rushed work.</span>
        <span>No copy-and-paste designs.</span>
        <span>No making you feel awkward for asking questions.</span>
      </div>
    </div>
  </section>

  <section class="section quick-links-section muted">
    <div class="section-heading">
      <p class="eyebrow">Before you book</p>
      <h2>Need the practical details?</h2>
    </div>
    <div class="quick-link-grid">
      <article>
        <h3>How It Works</h3>
        <p>See the full booking process, from first enquiry and references through to deposit, artwork and appointment day.</p>
        <a class="button secondary" href={`${base}contact/#how-it-works`}>View how it works</a>
      </article>
      <article>
        <h3>FAQs</h3>
        <p>Quick answers on pain, breaks, what to wear, numbing cream, medication, deposits and rearranging.</p>
        <a class="button secondary" href={`${base}contact/#faqs`}>Read FAQs</a>
      </article>
    </div>
  </section>

  <section class="section gallery-preview">
    <div class="section-heading">
      <p class="eyebrow">Recent work</p>
      <h2>Browse recent tattoos, healed pieces, custom designs and available flash.</h2>
    </div>
    <div class="photo-grid compact" aria-label="Gallery preview">
      {galleryPreview.map((image) => (
        <a class="photo-card" href={`${base}gallery/`}>
          <img src={image.src} alt={image.label} loading="lazy" />
          <span>{image.label}</span>
        </a>
      ))}
    </div>
    <a class="text-link" href={`${base}gallery/`}>View full gallery</a>
  </section>

  <section class="section cta-band">
    <div>
      <p class="eyebrow">Ready to talk through an idea?</p>
      <h2>You do not need to have everything worked out before getting in touch.</h2>
    </div>
    <a class="button primary" href={`${base}contact/`}>Start your booking enquiry</a>
  </section>
</BaseLayout>
