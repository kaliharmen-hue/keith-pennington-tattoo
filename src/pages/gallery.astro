---
import BaseLayout from '../layouts/BaseLayout.astro';

const categories = ['Recent tattoos', 'Black and grey', 'Fine line and script', 'Custom pieces', 'Cover-ups and reworks', 'Available designs'];
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const galleryImages = Array.from({ length: 39 }, (_, index) => {
  const number = String(index + 1).padStart(2, '0');
  return {
    src: `${base}assets/gallery/gallery-${number}.jpeg`,
    alt: `Tattoo work by Keith Pennington, image ${index + 1}`
  };
});
---
<BaseLayout
  current="gallery"
  title="Tattoo Gallery | Recent Work by Keith Pennington at Inked Skin"
  description="View recent tattoo work by Keith Pennington at Inked Skin, including black and grey tattoos, fine line pieces, script, custom designs and cover-ups in Southampton."
>
  <section class="page-hero">
    <p class="eyebrow">Gallery</p>
    <h1>Recent work by Keith Pennington</h1>
    <p>A selection of recent tattoo work from Inked Skin, including custom pieces, healed tattoos and available designs.</p>
  </section>

  <section class="section gallery-intro">
    <div class="prose">
      <p>Use this page to get a feel for Keith's style, approach and level of detail. Every tattoo is designed around the client, the placement and the way the piece will sit on the body.</p>
      <p>Tattoos are not flat artwork. They move with the body, age with the skin and become part of the person wearing them. That is why Keith considers placement, scale, line weight, contrast and long-term wear before each piece begins.</p>
    </div>
    <div class="category-list" aria-label="Gallery categories">
      {categories.map((category) => <a href="#work">{category}</a>)}
    </div>
  </section>

  <section class="section" id="work">
    <div class="photo-grid full-gallery">
      {galleryImages.map((image, index) => (
        <a class="photo-card" href={image.src} data-lightbox-image={image.src} data-lightbox-alt={image.alt}>
          <img src={image.src} alt={image.alt} loading={index < 6 ? 'eager' : 'lazy'} />
        </a>
      ))}
    </div>
  </section>

  <div class="lightbox" data-lightbox hidden>
    <button class="lightbox-close" type="button" data-lightbox-close aria-label="Close image">X</button>
    <img data-lightbox-img src="" alt="" />
  </div>

  <section class="section cta-band">
    <div>
      <p class="eyebrow">Seen something you like?</p>
      <h2>Use the gallery as a starting point for the style, size or feel you are drawn to.</h2>
      <p>Keith does not copy another artist's work, but he can help shape your idea into something original.</p>
    </div>
    <a class="button primary" href={`${base}contact/`}>Make an enquiry</a>
  </section>

  <script>
    const lightbox = document.querySelector('[data-lightbox]');
    const lightboxImage = document.querySelector('[data-lightbox-img]');
    const closeButton = document.querySelector('[data-lightbox-close]');
    const imageLinks = document.querySelectorAll('[data-lightbox-image]');

    const closeLightbox = () => {
      lightbox?.setAttribute('hidden', '');
      document.body.classList.remove('lightbox-open');
      if (lightboxImage instanceof HTMLImageElement) {
        lightboxImage.removeAttribute('src');
        lightboxImage.alt = '';
      }
    };

    imageLinks.forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        const imageSrc = link.getAttribute('data-lightbox-image');
        const imageAlt = link.getAttribute('data-lightbox-alt') || 'Tattoo gallery image';

        if (!imageSrc || !(lightboxImage instanceof HTMLImageElement)) {
          return;
        }

        lightboxImage.src = imageSrc;
        lightboxImage.alt = imageAlt;
        lightbox?.removeAttribute('hidden');
        document.body.classList.add('lightbox-open');
        closeButton?.focus();
      });
    });

    closeButton?.addEventListener('click', closeLightbox);
    lightbox?.addEventListener('click', (event) => {
      if (event.target === lightbox) {
        closeLightbox();
      }
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !lightbox?.hasAttribute('hidden')) {
        closeLightbox();
      }
    });
  </script>
</BaseLayout>
